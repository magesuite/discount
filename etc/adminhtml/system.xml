<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="catalog">
            <group id="frontend">
                <field id="minimal_sale_percentage" translate="label" type="text" sortOrder="350" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Minimal Sale Percentage</label>
                    <comment>The discount badge will be visible only if discount is bigger than this value.</comment>
                    <frontend_class>cs-csfeature__logo</frontend_class>
                </field>
                <field id="rounding_sale_percentage" translate="label" type="select" sortOrder="355" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Rounding Sale Percentage</label>
                    <source_model>MageSuite\Discount\Model\Config\Source\RoundingType</source_model>
                    <frontend_class>cs-csfeature__logo</frontend_class>
                </field>
                <field id="is_special_price_resolver_enabled" translate="label" type="select" sortOrder="360" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Sale badge visibility on frontend calculated from Special Price</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When this option is set to "Yes" then product badges visibility will be calculated from Special Price.</comment>
                    <frontend_class>cs-csfeature__logo</frontend_class>
                </field>
                <field id="sale_percentage_calculation_type" translate="label" type="select" sortOrder="370" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Sale badge percentage calculation type</label>
                    <source_model>MageSuite\Discount\Model\Config\Source\CalculationType</source_model>
                    <comment>Settings for Configurable Products. Defines whether percentage should be calculated based on cheapest and most expensive simple product, or biggest percentage between special and regular price within single configuration.</comment>
                    <frontend_class>cs-csfeature__logo</frontend_class>
                </field>
                <field id="show_biggest_discount_from_children_of_grouped_product" translate="label" type="select" sortOrder="380" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Show Biggest Discount From Children of Grouped Product</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Settings for Grouped Products. When enabled returned discount will be higher value from all children.</comment>
                    <frontend_class>cs-csfeature__logo</frontend_class>
                </field>
            </group>
        </section>
    </system>
</config>
